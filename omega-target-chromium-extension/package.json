{
  "name": "omega-target-chromium-extension",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node scripts/build-extension.js && tsdown --config tsdown.config.ts",
    "dev": "node scripts/build-extension.js && tsdown --config tsdown.config.ts --watch",
    "release": "BUILD=release npm run build && node scripts/release.js",
    "test": "echo 'No tests in omega-target-chromium-extension (covered by omega-pac/omega-target)'",
    "lint": "eslint src/ --no-cache",
    "clean": "rm -rf build/ dist/ index.js"
  },
  "dependencies": {
    "heap-js": "^2.7.1",
    "omega-pac": "workspace:*",
    "omega-target": "workspace:*",
    "omega-web": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "archiver": "^7.0.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "gettext-parser": "^8.0.0",
    "tsdown": "^0.22.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2"
  }
}
