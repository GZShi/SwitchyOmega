{
  "name": "omega-target-chromium-extension",
  "version": "0.0.1",
  "private": true,
  "main": "./index",
  "scripts": {
    "build": "node scripts/build-extension.js && webpack",
    "dev": "node scripts/build-extension.js && webpack --mode development",
    "release": "BUILD=release npm run build && node scripts/release.js",
    "test": "mocha --require coffee-script/register --reporter spec test/**/*.coffee",
    "clean": "rm -rf build/ tmp/ release.zip index.js"
  },
  "dependencies": {
    "heap": "^0.2.6",
    "omega-pac": "workspace:*",
    "omega-target": "workspace:*",
    "omega-web": "workspace:*",
    "xhr": "^1.16.0"
  },
  "devDependencies": {
    "@types/bluebird": "^3.5.42",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.0",
    "archiver": "^7.0.0",
    "chai": "^4.3.0",
    "mocha": "^10.0.0",
    "node-polyfill-webpack-plugin": "^4.0.0",
    "po2json": "^0.3.2",
    "terser-webpack-plugin": "^5.3.0",
    "ts-loader": "^9.5.7",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.0"
  }
}
