{
  "name": "omega-target",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./browser": "./dist/omega_target.min.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "dev": "tsdown --config tsdown.config.ts --watch",
    "test": "mocha --require tsx/cjs --reporter spec test/**/*.test.ts",
    "lint": "eslint src/ test/ --no-cache",
    "verify:parity": "node scripts/verify-parity.cjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "jsondiffpatch": "0.1.43",
    "limiter": "^3.0.0",
    "omega-pac": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.0",
    "@types/sinon": "^21.0.1",
    "@types/sinon-chai": "^4.0.0",
    "chai": "^4.3.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "mocha": "^10.0.0",
    "sinon": "^17.0.0",
    "sinon-chai": "^3.7.0",
    "tsdown": "^0.22.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2"
  }
}
