{
  "name": "omega-web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "npm run build:pug && npm run build:less && npm run build:coffee && npm run build:annotate && npm run build:copy",
    "build:pug": "jade --pretty src/*.jade --out build/ && jade --pretty src/partials/*.jade --out build/partials/",
    "build:less": "lessc src/less/options.less build/css/options.css && lessc src/less/popup.less build/css/popup.css && postcss build/css/*.css --use autoprefixer --replace --no-map",
    "build:coffee": "coffee -c -o build/js/ src/coffee/*.coffee && coffee -j build/js/omega.js -c src/omega/app.coffee src/omega/controllers/*.coffee src/omega/directives.coffee src/omega/filters.coffee",
    "build:annotate": "ng-annotate --add --single_quotes build/js/omega.js -o build/js/omega.ngmin.js",
    "build:copy": "node scripts/copy-libs.js",
    "dev": "npm run build",
    "test": "mocha --require coffee-script/register --reporter spec test/**/*.coffee || true",
    "clean": "rm -rf build/"
  },
  "dependencies": {
    "omega-pac": "workspace:*"
  },
  "devDependencies": {
    "angular": "~1.7.2",
    "angular-animate": "~1.7.2",
    "angular-i18n": "~1.7.2",
    "angular-ladda": "~0.2.1",
    "angular-loader": "~1.7.2",
    "angular-sanitize": "~1.7.2",
    "angular-spectrum-colorpicker": "~1.4.5",
    "angular-ui-bootstrap": "~0.12.1",
    "angular-ui-router": "~0.2.18",
    "angular-ui-sortable": "~0.13.3",
    "angular-ui-utils": "^0.1.1",
    "autoprefixer": "^10.4.0",
    "blob-util": "^2.0.0",
    "bootstrap": "~3.3.7",
    "chai": "^4.3.0",
    "coffee-script": "^1.12.7",
    "coffeescript": "^1.12.7",
    "file-saver": "^1.3.3",
    "jade": "^1.11.0",
    "jquery": "^3.0.0",
    "jquery-ui": "^1.12.0",
    "jquery-ui-touch-punch": "^0.2.3",
    "jsondiffpatch": "^0.1.8",
    "ladda": "^0.9.8",
    "less": "^4.2.0",
    "mocha": "^10.0.0",
    "ng-annotate": "^1.2.2",
    "ngprogress": "^1.0.4",
    "postcss": "^8.4.0",
    "postcss-cli": "^11.0.0",
    "scriptjs": "^2.5.3",
    "shepherd.js": "github:HubSpot/shepherd#v0.5.1",
    "spectrum-colorpicker": "^1.8.0"
  }
}
