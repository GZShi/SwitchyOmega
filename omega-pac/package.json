    "@types/astring": "^1.7.4",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.0",
    "chai": "^4.3.0",
    "mocha": "^10.0.0",
    "tsdown": "^0.14.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
