{
  "name": "omega-pac",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "dev": "tsdown --config tsdown.config.ts --watch",
    "test": "TZ=Europe/London mocha --require tsx/cjs --reporter spec test/*.test.ts",
    "lint": "eslint src/ test/ --no-cache",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "astring": "^1.9.0",
    "ip-address": "^10.0.0",
    "tldts": "^6.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sinonjs/fake-timers": "^13.0.0",
    "@types/astring": "^1.7.4",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.0",
    "chai": "^4.3.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "mocha": "^10.0.0",
    "tsdown": "^0.22.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2"
  }
}
